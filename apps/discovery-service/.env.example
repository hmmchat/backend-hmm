PORT=3004
NODE_ENV=development

# Database (if used)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/discovery-service?schema=public

# Auth (JWT/JWKS)
JWT_ISSUER=backend-hmm
JWT_AUDIENCE=backend-hmm
# AUTH_PRIVATE_KEY_PEM=...
# AUTH_PUBLIC_JWKS_URL=http://localhost:3010/.well-known/jwks.json

# Redis (if used)
REDIS_URL=redis://localhost:6379

# --- Discovery match scoring (card ranking) ---
# Points per common brand
MATCH_SCORE_BRAND=10
# Points per exact interest match (same sub-genre)
MATCH_SCORE_INTEREST_EXACT=15
# Points per genre match (same genre, different sub-genre)
MATCH_SCORE_INTEREST_GENRE=10
# Points per common value
MATCH_SCORE_VALUE=20
# Points when music preference matches
MATCH_SCORE_MUSIC=30
# Points when same city (anywhere mode)
MATCH_SCORE_SAME_CITY=50
# Points when video preference matches
MATCH_SCORE_VIDEO=100
# Bonus points for routing unverified users to moderators
MATCH_SCORE_MODERATOR_PRIORITY=500

# --- Broadcast recommendation scoring ---
MATCH_SCORE_BROADCAST_TRENDING=50
MATCH_SCORE_BROADCAST_POPULARITY_CAP=30
MATCH_SCORE_BROADCAST_VIEWERS_CAP=20
MATCH_SCORE_BROADCAST_RECENCY_VERY=15
MATCH_SCORE_BROADCAST_RECENCY_RECENT=10
MATCH_SCORE_BROADCAST_RECENCY_TODAY=5
MATCH_SCORE_BROADCAST_TAG=5

# --- Discovery pool & location limits ---
# Max users to fetch for card pool / matching
DISCOVERY_POOL_LIMIT=500
# Max users per city for cities/nearby endpoints
CITIES_MAX_USERS_LIMIT=100

# --- KYC moderator routing ---
# KYC_ENABLED=false
# KYC_MODERATOR_PRIORITY_ENABLED=false

# --- Moderator face card (when user.moderatorFaceCardActive) ---
# Prefer Beam dashboard → Moderator face card (/v1/admin/moderator-face-card).
# Env vars below are fallback if DB row is missing or image URL unset:
# MODERATOR_FACE_CARD_USERNAME=Moderator
# MODERATOR_FACE_CARD_INTENT=Moderation
# MODERATOR_FACE_CARD_DISPLAY_PICTURE_URL=https://...
# MODERATOR_FACE_CARD_CITY=Beam
# MODERATOR_FACE_CARD_CACHE_MS=60000

# --- Squad ---
# Invitation expiry (ms). Default 10 min
SQUAD_INVITATION_TIMEOUT_MS=600000
# Max squad size (1 inviter + 2 invitees = 3)
MAX_SQUAD_SIZE=3

# R2/S3 (files-service)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Semantic batch matchmaking (full rollout — no production users yet) ---
# Default: batch_primary for all cities. Legacy matcher is fallback only if no batch match in wait window.
# live_legacy | shadow | batch_primary
MATCHING_MODE=batch_primary
MATCHING_PAUSED=false
MATCHING_SEMANTIC_ENABLED=true
MATCHING_ALLOCATOR_INTERVAL_MS=2000
MATCHING_MAX_POOL_SIZE=1000
MATCHING_2OPT_ITERATIONS=2
MATCHING_FAIRNESS_WAIT_BOOST=0.1
# Wait for batch match before legacy fallback
MATCHING_CARD_WAIT_MS=2500
# Leave empty = all cities (full rollout). Set only if you later want a city restrict list.
# MATCHING_CANARY_CITIES=

# Score weights (sum normalized to 100). Default: intent 50%, rest keeps prior ratio 25:18:15:8:4 → ~17.86/12.86/10.71/5.71/2.86
MATCHING_SCORE_WEIGHT_INTENT=50
MATCHING_SCORE_WEIGHT_SONG=17.8571428571
MATCHING_SCORE_WEIGHT_BRANDS=12.8571428571
MATCHING_SCORE_WEIGHT_INTERESTS=10.7142857143
MATCHING_SCORE_WEIGHT_VALUES=5.7142857143
MATCHING_SCORE_WEIGHT_LOCATION=2.8571428571

# Embeddings (OpenAI-compatible). Required for real semantic intent matching.
# Without EMBEDDING_API_KEY, features are provider=fallback (lexical only — not semantic).
EMBEDDING_API_URL=https://api.openai.com/v1/embeddings
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=512
EMBEDDING_MAX_BATCH=100
EMBEDDING_COST_PER_1K_INR=0.01

# Feature generation worker
FEATURE_GENERATION_WORKER_INTERVAL_MS=5000
FEATURE_GENERATION_BATCH_SIZE=10
FEATURE_GENERATION_JOB_LEASE_MS=120000

# Cost budgets (INR) — hard stop when exceeded (still enforced on full rollout)
MATCHMAKING_MONTHLY_BUDGET_INR=10000
MATCHMAKING_DAILY_BUDGET_INR=500

# City handoff UI (empty pool → next city face card)
CITY_HANDOFF_COUNTDOWN_SECONDS=10
# Fast poll while countdown is active (abort if city empties)
CITY_HANDOFF_VALIDITY_POLL_MS=3000
# Slower poll on city boxes / empty orbit (production load)
DISCOVERY_AVAILABLE_CITIES_POLL_MS=5000
# Matchmaking face-card Raincheck lock (grey wipe). Offline cards unaffected. 0 = immediate.
RAINCHECK_UNLOCK_SECONDS=3
# Meet rn waiting cancel (X) appears after this many seconds. 0 = immediate.
MEET_RN_CANCEL_UNLOCK_SECONDS=10

# Admin matching endpoints (X-Admin-Token). Required; fail closed if unset.
ADMIN_API_TOKEN=

# Internal service token (user-service → discovery feature enqueue)
INTERNAL_SERVICE_TOKEN=

# Report score → moderator mix ratios (T1/T2/T3). Remainder are normal users. Empty if bucket unmet.
# DISCOVERY_REPORT_MIX_L1=0.3
# DISCOVERY_REPORT_MIX_L2=0.6
# DISCOVERY_REPORT_MIX_L3=0.95
