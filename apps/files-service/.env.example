PORT=3008
NODE_ENV=development

# Database (if used)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/files-service?schema=public

# Auth (JWT/JWKS)
JWT_ISSUER=backend-hmm
JWT_AUDIENCE=backend-hmm
# AUTH_PRIVATE_KEY_PEM=...
# AUTH_PUBLIC_JWKS_URL=http://localhost:3010/.well-known/jwks.json

# Redis (if used)
REDIS_URL=redis://localhost:6379

# --- Files: image limits ---
# Max image dimensions (resize if larger)
IMAGE_MAX_WIDTH=2000
IMAGE_MAX_HEIGHT=2000
# Max image file size (MB)
IMAGE_MAX_FILE_SIZE_MB=10
# Default thumbnail side (px)
IMAGE_THUMBNAIL_SIZE=200
# Multipart upload max size (MB); should be >= IMAGE_MAX_FILE_SIZE_MB
FILE_UPLOAD_MAX_SIZE_MB=10
# Default limit for GET /me/files
FILES_LIST_DEFAULT_LIMIT=50

# R2/S3 (files-service) — persist public download URLs, not 7-day signed GETs
R2_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
R2_REGION=eu-central-003
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=beam-uploads
R2_PUBLIC_URL=https://f003.backblazeb2.com/file/beam-uploads

# --- Image moderation (production only) ---
MODERATION_SERVICE_URL=http://localhost:3003
MODERATION_PRODUCTION_ONLY=true
# Only these folders run Sightengine — end-user profile photos (3 slots). Dashboard uploads skip.
MODERATION_FOLDERS=profile-photos
# Extra hard skips (even if listed in MODERATION_FOLDERS)
MODERATION_SKIP_FOLDERS=friends-wall-share
# MODERATION_CHECK_TIMEOUT_MS=25000
# SKIP_MODERATION_CHECK=false

