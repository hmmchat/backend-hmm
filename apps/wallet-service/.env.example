PORT=3005
NODE_ENV=development

# Database. Must point to the DB that has wallets and transactions (wallet-service tables).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wallet-service?schema=public

# Auth (JWT/JWKS)
JWT_ISSUER=backend-hmm
JWT_AUDIENCE=backend-hmm
# AUTH_PRIVATE_KEY_PEM=...
# AUTH_PUBLIC_JWKS_URL=http://localhost:3010/.well-known/jwks.json

# Redis (if used)
REDIS_URL=redis://localhost:6379

# Request timeout (ms). Should be less than gateway timeout
WALLET_REQUEST_TIMEOUT_MS=8000

# Shared service-to-service token used by user-service for internal reward endpoint
INTERNAL_SERVICE_TOKEN=change-me-in-production

# Admin API token for Mystery Beam Box / Season ops (X-Admin-Token). Match discovery-service / dashboard ADMIN_API_TOKEN.
ADMIN_API_TOKEN=

# JWT verification for /me/season (same as other wallet user routes)
JWT_PUBLIC_JWK=

# Coins per 1 diamond (e.g. 100 = 100 coins to buy 1 diamond). Align with payment-service DIAMOND_TO_COIN_RATE.
DIAMOND_TO_COIN_RATE=100

# Coin mining (server-authoritative time + FaceCard + referral rewards)
COIN_MINING_THRESHOLD_MINUTES=15
COIN_MINING_BROADCAST_REWARD=15
COIN_MINING_VIDEO_CALL_REWARD=10
COIN_MINING_VIEWER_REWARD=5
COIN_MINING_FACECARD_REWARD=10
COIN_MINING_REFERRAL_REWARD=20
# Mid-session settle interval (ms) so thresholds credit without client heartbeats
COIN_MINING_TICK_MS=30000

# R2/S3 (files-service)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
