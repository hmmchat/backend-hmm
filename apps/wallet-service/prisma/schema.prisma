// Prisma schema for wallet-service
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

// Tables owned and managed by wallet-service
// These tables are in the wallet-service database

// Note: User, GenderFilterPreference, RaincheckSession, and other tables are owned by their respective services.
// Access user data via HTTP API calls to user-service.
// Access discovery data via HTTP API calls to discovery-service.

model Wallet {
  id        String   @id // Links to auth-service User.id (must match auth-service user id)
  balance   Int      @default(0) // Coin balance (non-negative)
  diamonds  Int      @default(0) // Diamond balance (non-negative); separate from coins
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Transaction history
  transactions Transaction[]

  @@map("wallets")
}

model Transaction {
  id               String            @id @default(cuid())
  walletId         String
  wallet           Wallet            @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount           Int // Positive for credits, negative for debits (coins)
  type             TransactionType
  description      String?
  giftId           String? // Gift sticker ID - only for CREDIT transactions from gifts
  diamondAmount    Int? // Delta for diamonds; used when transactionKind is DIAMONDS or CONVERSION
  transactionKind  TransactionKind? // COINS | DIAMONDS | CONVERSION
  createdAt        DateTime          @default(now())

  @@index([walletId])
  @@index([createdAt])
  @@index([giftId])
  @@map("transactions")
}

enum TransactionType {
  CREDIT
  DEBIT
  REFUND
  ADJUSTMENT
}

enum TransactionKind {
  COINS
  DIAMONDS
  CONVERSION
}

// ─── Mystery Beam Box / Seasons ─────────────────────────────────────────────

enum SeasonStatus {
  DRAFT
  ACTIVE
  ENDED
}

enum SeasonTaskType {
  UNIQUE_STRANGERS
  BEAM_MINUTES
  BEAMCAST_MINUTES
  DIAMONDS_EARNED
}

enum SeasonClaimStatus {
  PENDING
  REJECTED
  APPROVED
  GIFT_SENT
  GIFT_RECEIVED
}

model Season {
  id            String       @id @default(cuid())
  name          String
  status        SeasonStatus @default(DRAFT)
  giftPoolSize  Int          @default(1000)
  approvedCount Int          @default(0)
  startedAt     DateTime?
  endedAt       DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  tasks    SeasonTask[]
  progress UserSeasonProgress[]
  claims   SeasonClaim[]
  events   SeasonProgressEvent[]

  @@index([status])
  @@map("seasons")
}

model SeasonTask {
  id        String         @id @default(cuid())
  seasonId  String
  season    Season         @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  taskType  SeasonTaskType
  enabled   Boolean        @default(true)
  target    Int
  label     String
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([seasonId, taskType])
  @@index([seasonId])
  @@map("season_tasks")
}

model UserSeasonProgress {
  id               String    @id @default(cuid())
  seasonId         String
  season           Season    @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  userId           String
  uniqueStrangers  Int       @default(0)
  beamSeconds      Int       @default(0)
  beamcastSeconds  Int       @default(0)
  diamondsEarned   Int       @default(0)
  tasksCompletedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([seasonId, userId])
  @@index([userId])
  @@index([seasonId])
  @@map("user_season_progress")
}

/// Lifetime unique participatory call peers (not Beam TV viewers).
model UserCallPeer {
  id              String   @id @default(cuid())
  userId          String
  peerUserId      String
  firstConnectedAt DateTime @default(now())

  @@unique([userId, peerUserId])
  @@index([userId])
  @@map("user_call_peers")
}

model SeasonClaim {
  id              String            @id @default(cuid())
  seasonId        String
  season          Season            @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  userId          String
  status          SeasonClaimStatus @default(PENDING)
  recipientName   String
  phone           String
  addressLine1    String
  addressLine2    String?
  addressLine3    String?
  landmark        String?
  state           String
  city            String
  pincode         String
  rejectMessage   String?
  courierName     String?
  trackingNumber  String?
  submittedAt     DateTime          @default(now())
  approvedAt      DateTime?
  rejectedAt      DateTime?
  giftSentAt      DateTime?
  giftReceivedAt  DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([seasonId, userId])
  @@index([seasonId, status])
  @@index([userId])
  @@map("season_claims")
}

/// Idempotency keys for streaming session contributions (minutes).
model SeasonProgressEvent {
  id        String   @id @default(cuid())
  seasonId  String
  season    Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  userId    String
  eventKey  String
  createdAt DateTime @default(now())

  @@unique([seasonId, userId, eventKey])
  @@index([seasonId])
  @@map("season_progress_events")
}

// ─── Coin mining ─────────────────────────────────────────────────────────────

enum CoinMiningBucket {
  BROADCAST
  VIDEO_CALL
  VIEWER
}

/// Persistent remainder seconds toward the next threshold per time bucket.
model UserCoinMiningProgress {
  userId                     String    @id
  broadcastRemainderSeconds  Int       @default(0)
  videoCallRemainderSeconds  Int       @default(0)
  viewerRemainderSeconds     Int       @default(0)
  faceCardRewardedAt         DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  @@map("user_coin_mining_progress")
}

/// At most one active earning session per user (exclusive bucket).
model CoinMiningActiveSession {
  userId        String           @id
  bucket        CoinMiningBucket
  startedAt     DateTime         @default(now())
  lastSettledAt DateTime         @default(now())
  roomId        String?
  sessionId     String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([bucket])
  @@map("coin_mining_active_sessions")
}

/// Idempotent referrer-only payout when referred user hits FaceCard 100%.
model CoinMiningReferralPayout {
  id                    String   @id @default(cuid())
  referredUserId        String   @unique
  referrerId            String
  referrerReward        Int
  referrerTransactionId String?
  awardedAt             DateTime @default(now())
  createdAt             DateTime @default(now())

  @@index([referrerId])
  @@map("coin_mining_referral_payouts")
}

/// Singleton lifetime counters for successful coin mines (V1 analytics).
model CoinMiningAnalytics {
  id              String   @id @default("global")
  broadcastMines  Int      @default(0)
  videoCallMines  Int      @default(0)
  viewerMines     Int      @default(0)
  faceCardMines   Int      @default(0)
  referralMines   Int      @default(0)
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@map("coin_mining_analytics")
}
